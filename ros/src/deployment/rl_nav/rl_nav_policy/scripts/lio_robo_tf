"""Publish world -> base_footprint from Super-LIO robot odometry."""

import numpy as np
import rclpy
from geometry_msgs.msg import TransformStamped
from nav_msgs.msg import Odometry
from rclpy.duration import Duration
from rclpy.node import Node
from rclpy.time import Time
from tf2_ros import Buffer, TransformBroadcaster, TransformException, TransformListener


def xyz_quat_to_mat(x, y, z, qx, qy, qz, qw):
    """Convert translation plus quaternion into a 4x4 pose matrix."""
    norm = max((qx * qx + qy * qy + qz * qz + qw * qw) ** 0.5, 1.0e-12)
    qx, qy, qz, qw = qx / norm, qy / norm, qz / norm, qw / norm
    xx, yy, zz = qx * qx, qy * qy, qz * qz
    xy, xz, yz = qx * qy, qx * qz, qy * qz
    wx, wy, wz = qw * qx, qw * qy, qw * qz
    matrix = np.eye(4)
    matrix[0, 0] = 1.0 - 2.0 * (yy + zz)
    matrix[0, 1] = 2.0 * (xy - wz)
    matrix[0, 2] = 2.0 * (xz + wy)
    matrix[1, 0] = 2.0 * (xy + wz)
    matrix[1, 1] = 1.0 - 2.0 * (xx + zz)
    matrix[1, 2] = 2.0 * (yz - wx)
    matrix[2, 0] = 2.0 * (xz - wy)
    matrix[2, 1] = 2.0 * (yz + wx)
    matrix[2, 2] = 1.0 - 2.0 * (xx + yy)
    matrix[0, 3] = x
    matrix[1, 3] = y
    matrix[2, 3] = z
    return matrix


def mat_to_xyz_quat(matrix):
    """Convert a 4x4 pose matrix into translation plus quaternion."""
    rotation = matrix[:3, :3]
    trace = np.trace(rotation)
    if trace > 0.0:
        scale = 0.5 / np.sqrt(trace + 1.0)
        qw = 0.25 / scale
        qx = (rotation[2, 1] - rotation[1, 2]) * scale
        qy = (rotation[0, 2] - rotation[2, 0]) * scale
        qz = (rotation[1, 0] - rotation[0, 1]) * scale
    elif rotation[0, 0] > rotation[1, 1] and rotation[0, 0] > rotation[2, 2]:
        scale = 2.0 * np.sqrt(
            1.0 + rotation[0, 0] - rotation[1, 1] - rotation[2, 2]
        )
        qw = (rotation[2, 1] - rotation[1, 2]) / scale
        qx = 0.25 * scale
        qy = (rotation[0, 1] + rotation[1, 0]) / scale
        qz = (rotation[0, 2] + rotation[2, 0]) / scale
    elif rotation[1, 1] > rotation[2, 2]:
        scale = 2.0 * np.sqrt(
            1.0 + rotation[1, 1] - rotation[0, 0] - rotation[2, 2]
        )
        qw = (rotation[0, 2] - rotation[2, 0]) / scale
        qx = (rotation[0, 1] + rotation[1, 0]) / scale
        qy = 0.25 * scale
        qz = (rotation[1, 2] + rotation[2, 1]) / scale
    else:
        scale = 2.0 * np.sqrt(
            1.0 + rotation[2, 2] - rotation[0, 0] - rotation[1, 1]
        )
        qw = (rotation[1, 0] - rotation[0, 1]) / scale
        qx = (rotation[0, 2] + rotation[2, 0]) / scale
        qy = (rotation[1, 2] + rotation[2, 1]) / scale
        qz = 0.25 * scale
    return (
        float(matrix[0, 3]),
        float(matrix[1, 3]),
        float(matrix[2, 3]),
        float(qx),
        float(qy),
        float(qz),
        float(qw),
    )


def transform_to_mat(transform):
    """Convert a Transform message into a 4x4 pose matrix."""
    translation = transform.translation
    rotation = transform.rotation
    return xyz_quat_to_mat(
        translation.x,
        translation.y,
        translation.z,
        rotation.x,
        rotation.y,
        rotation.z,
        rotation.w,
    )


class LioRoboTf(Node):
    """Attach the URDF root to Super-LIO's world frame."""

    def __init__(self):
        super().__init__("lio_robo_tf")
        self.odom_topic = self.declare_parameter(
            "odom_topic", "/lio/robo/odom"
        ).value
        self.parent_frame = self.declare_parameter(
            "parent_frame", "world"
        ).value
        self.child_frame = self.declare_parameter(
            "child_frame", "base_footprint"
        ).value
        self.odom_body_frame = self.declare_parameter(
            "odom_body_frame", "LINK_TORSO_YAW"
        ).value
        self.tf_timeout = max(
            float(self.declare_parameter("tf_timeout", 0.05).value),
            0.0,
        )

        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(self.tf_buffer, self)
        self.broadcaster = TransformBroadcaster(self)
        self.create_subscription(Odometry, self.odom_topic, self.on_odom, 10)
        self.get_logger().info(
            f"Broadcasting {self.parent_frame} -> {self.child_frame} from "
            f"{self.odom_topic} ({self.odom_body_frame})"
        )

    def on_odom(self, message):
        pose = message.pose.pose
        world_torso = xyz_quat_to_mat(
            pose.position.x,
            pose.position.y,
            pose.position.z,
            pose.orientation.x,
            pose.orientation.y,
            pose.orientation.z,
            pose.orientation.w,
        )
        world_base = world_torso
        if self.odom_body_frame != self.child_frame:
            try:
                torso_base = self.tf_buffer.lookup_transform(
                    self.odom_body_frame,
                    self.child_frame,
                    Time.from_msg(message.header.stamp),
                    timeout=Duration(seconds=self.tf_timeout),
                )
            except TransformException:
                try:
                    torso_base = self.tf_buffer.lookup_transform(
                        self.odom_body_frame,
                        self.child_frame,
                        Time(),
                        timeout=Duration(seconds=self.tf_timeout),
                    )
                except TransformException as error:
                    self.get_logger().warning(
                        f"Waiting for {self.odom_body_frame} -> "
                        f"{self.child_frame}: {error}",
                        throttle_duration_sec=2.0,
                    )
                    return
            world_base = world_torso @ transform_to_mat(torso_base.transform)

        x, y, z, qx, qy, qz, qw = mat_to_xyz_quat(world_base)
        tf_msg = TransformStamped()
        tf_msg.header.stamp = message.header.stamp
        tf_msg.header.frame_id = self.parent_frame
        tf_msg.child_frame_id = self.child_frame
        tf_msg.transform.translation.x = x
        tf_msg.transform.translation.y = y
        tf_msg.transform.translation.z = z
        tf_msg.transform.rotation.x = qx
        tf_msg.transform.rotation.y = qy
        tf_msg.transform.rotation.z = qz
        tf_msg.transform.rotation.w = qw
        self.broadcaster.sendTransform(tf_msg)


def main(args=None):
    rclpy.init(args=args)
    node = LioRoboTf()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
